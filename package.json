  "scripts": {
    "ng": "ng",
    "build:scss": "scss-bundle --config scss-bundle.config.json",
    "input-build:scss": "scss-bundle --config scss-input.config.json",
    "start": "ng serve",
    "build": "ng build ng-dijta && node scripts/patch-dist-webpack.js && npm run build:scss",
    "test:webpack": "node --test projects/ng-dijta/webpack/__tests__/with-dx-remote.spec.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run lint && npm run typecheck && npm test -- --watch=false && npm run build",
    "doc": "npx compodoc -p tsconfig.json --hideGenerator  --name ngDijta --theme readthedocs",
    "docs:json": "compodoc -p ./tsconfig.json -e json -d .",
    "storybook": "ng run practice:storybook",
    "build-storybook": "ng run practice:build-storybook",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
